rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Admins are marked by role == 'admin' in their users document. Users
    // cannot change their own role, so only the console can grant it.
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function optionalString(data, field, max) {
      return !(field in data) || (data[field] is string && data[field].size() <= max);
    }
    function validRecipe(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 60
        && data.category is string && data.category.size() > 0 && data.category.size() <= 30
        && data.image is string && data.image.size() <= 500 && data.image.matches('^https?://.+')
        && data.time is int && data.time > 0 && data.time <= 1440
        && data.ingredientsName is list && data.ingredientsName.size() >= 2 && data.ingredientsName.size() <= 40
        && data.ingredientsAmount is list && data.ingredientsAmount.size() == data.ingredientsName.size()
        && data.step is list && data.step.size() >= 1 && data.step.size() <= 30
        && (!('tags' in data) || (data.tags is list
          && data.tags.hasOnly(['vegetarian', 'pedas', 'hemat', 'bekal', 'ramah-anak'])))
        && (!('allergens' in data) || (data.allergens is list
          && data.allergens.hasOnly(['telur', 'susu', 'kacang', 'seafood', 'gluten'])))
        && optionalString(data, 'imageAttribution', 200)
        && optionalString(data, 'calorieNote', 200)
        && (!('servings' in data) || data.servings is int);
    }
    function validCalories(value) {
      return value is int && value > 0 && value <= 5000;
    }
    // Recipes saved before the admin form exist without createdAt/createdBy
    // and with cal as text. Edits keep those values unless they are replaced.
    function keepsCreation(field) {
      return field in resource.data
        ? request.resource.data[field] == resource.data[field]
        : !(field in request.resource.data);
    }
    match /Complete-Flutter-App/{recipeId} {
      allow read: if request.auth != null;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'category', 'image', 'cal', 'time',
          'ingredientsName', 'ingredientsAmount', 'step', 'tags', 'allergens', 'imageAttribution',
          'calorieNote', 'servings', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && validRecipe(request.resource.data)
        && validCalories(request.resource.data.cal)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'category',
          'image', 'cal', 'time', 'ingredientsName', 'ingredientsAmount', 'step', 'tags', 'allergens',
          'imageAttribution', 'calorieNote', 'servings', 'updatedAt', 'updatedBy'])
        && validRecipe(request.resource.data)
        && (!('cal' in request.resource.data.diff(resource.data).affectedKeys())
          || validCalories(request.resource.data.cal))
        && keepsCreation('createdAt')
        && keepsCreation('createdBy')
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }
    match /App-Category/{categoryId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 30;
      allow delete: if isAdmin();
    }
    match /usernames/{username} {
      allow get: if true;
      allow create: if request.auth != null
        && username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
    }
    match /users/{uid} {
      // Admins can read user documents for the dashboard user count.
      allow read: if owner(uid) || isAdmin();
      allow create: if owner(uid)
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.resource.data.keys().hasOnly(['name', 'email', 'username', 'role', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'user'
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid
        && request.resource.data.createdAt == request.time;
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.updatedAt == request.time;
      match /fridge/{itemId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['name', 'ingredientId', 'amount', 'unit', 'categoryId', 'expiry', 'notes', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.ingredientId is string
          && request.resource.data.ingredientId.size() > 0
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.amount <= 100000
          && request.resource.data.unit in ['g', 'kg', 'ml', 'l', 'pcs']
          && request.resource.data.categoryId in ['produce', 'protein', 'dairy', 'grains', 'other']
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 300
          && request.resource.data.updatedAt == request.time;
      }
      match /stockOperations/{operationId} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['itemIds', 'createdAt'])
          && request.resource.data.itemIds is list
          && request.resource.data.itemIds.size() > 0
          && request.resource.data.itemIds.size() <= 50
          && request.resource.data.itemIds.toSet().size() == request.resource.data.itemIds.size()
          && request.resource.data.createdAt == request.time;
      }
      match /collections/{collectionId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['name', 'notes', 'recipeIds', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 300
          && request.resource.data.recipeIds is list
          && request.resource.data.recipeIds.size() <= 100
          && request.resource.data.recipeIds.toSet().size() == request.resource.data.recipeIds.size()
          && request.resource.data.updatedAt == request.time;
      }
      match /aiChats/{chatId} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['question', 'answer', 'createdAt'])
          && request.resource.data.question is string
          && request.resource.data.question.size() > 0
          && request.resource.data.question.size() <= 500
          && request.resource.data.answer is string
          && request.resource.data.answer.size() > 0
          && request.resource.data.answer.size() <= 4000
          && request.resource.data.createdAt == request.time;
      }
      match /favorites/{recipeId} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['recipeId', 'createdAt'])
          && request.resource.data.recipeId == recipeId
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/Complete-Flutter-App/$(recipeId));
      }
    }
  }
}
