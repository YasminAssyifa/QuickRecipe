rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /Complete-Flutter-App/{recipeId} {
      allow read: if request.auth != null;
    }
    match /App-Category/{categoryId} {
      allow read: if request.auth != null;
    }
    match /usernames/{username} {
      allow get: if true;
      allow create: if request.auth != null
        && username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.resource.data.keys().hasOnly(['name', 'email', 'username', 'role', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'user'
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid
        && request.resource.data.createdAt == request.time;
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.updatedAt == request.time;
      match /fridge/{itemId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['name', 'ingredientId', 'amount', 'unit', 'categoryId', 'expiry', 'notes', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.ingredientId is string
          && request.resource.data.ingredientId.size() > 0
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.amount <= 100000
          && request.resource.data.unit in ['g', 'kg', 'ml', 'l', 'pcs']
          && request.resource.data.categoryId in ['produce', 'protein', 'dairy', 'grains', 'other']
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 300
          && request.resource.data.updatedAt == request.time;
      }
      match /stockOperations/{operationId} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['itemIds', 'createdAt'])
          && request.resource.data.itemIds is list
          && request.resource.data.itemIds.size() > 0
          && request.resource.data.itemIds.size() <= 50
          && request.resource.data.itemIds.toSet().size() == request.resource.data.itemIds.size()
          && request.resource.data.createdAt == request.time;
      }
      match /collections/{collectionId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['name', 'notes', 'recipeIds', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 300
          && request.resource.data.recipeIds is list
          && request.resource.data.recipeIds.size() <= 100
          && request.resource.data.recipeIds.toSet().size() == request.resource.data.recipeIds.size()
          && request.resource.data.updatedAt == request.time;
      }
      match /favorites/{recipeId} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['recipeId', 'createdAt'])
          && request.resource.data.recipeId == recipeId
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/Complete-Flutter-App/$(recipeId));
      }
    }
  }
}
