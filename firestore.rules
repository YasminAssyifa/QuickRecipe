rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /Complete-Flutter-App/{recipeId} {
      allow read: if request.auth != null;
    }
    match /App-Category/{categoryId} {
      allow read: if request.auth != null;
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && ((request.auth.token.firebase.sign_in_provider == 'anonymous' && request.resource.data.email == '')
          || (request.auth.token.firebase.sign_in_provider != 'anonymous' && request.resource.data.email == request.auth.token.email))
        && request.resource.data.createdAt == request.time;
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.updatedAt == request.time;
      match /fridge/{itemId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['name', 'ingredientId', 'amount', 'unit', 'categoryId', 'expiry', 'notes', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.ingredientId is string
          && request.resource.data.ingredientId.size() > 0
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 100000
          && request.resource.data.unit in ['g', 'kg', 'ml', 'l', 'pcs']
          && request.resource.data.categoryId in ['produce', 'protein', 'dairy', 'grains', 'other']
          && request.resource.data.expiry is string
          && request.resource.data.expiry.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 300
          && request.resource.data.updatedAt == request.time;
      }
      match /collections/{collectionId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['name', 'notes', 'recipeIds', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 300
          && request.resource.data.recipeIds is list
          && request.resource.data.recipeIds.size() <= 100
          && request.resource.data.recipeIds.toSet().size() == request.resource.data.recipeIds.size()
          && request.resource.data.updatedAt == request.time;
      }
      match /favorites/{recipeId} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['recipeId', 'createdAt'])
          && request.resource.data.recipeId == recipeId
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/Complete-Flutter-App/$(recipeId));
      }
    }
  }
}
